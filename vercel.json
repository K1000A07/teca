{
  "rewrites": [
    {
      "source": "/regalo/:code",
      "destination": "/api/invite?code=:code"
    },
    {
      "source": "/r/:u",
      "destination": "/api/ref?u=:u"
    },
    {
      "source": "/((?!api/|assets/|icons/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/|icons/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
